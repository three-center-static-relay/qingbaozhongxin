{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intelligence-provider-selftest",
  "main": "src/production-guard.js",
  "compatibility_date": "2026-08-15",
  "durable_objects": {"bindings": [{"name": "CENTER_GATE", "class_name": "CenterGate"}]},
  "exports": {"CenterGate": {"type":"durable-object","storage":"sqlite"}},
  "vars": {
    "RATE_LIMIT_PER_MIN": "300",
    "GOOGLE_CLOUD_ACCESS_TOKEN": "unit-google-token",
    "GOOGLE_CLOUD_PROJECT": "unit-project",
    "PKULAW_MCP_TOKEN": "unit-pkulaw-token",
    "WIND_API_KEY": "unit-wind-key"
  }
}
