  "schema_version": "2026-08-15.1",
  "purpose": "Priority registry for university research-data repositories, university-managed flagship datasets, and high-value industry/regional research databases. It complements the global public dataset platform registry and does not mirror raw repositories.",
  "coverage_strategy": {
    "institution_resolution": ["ROR", "re3data", "OpenDOAR", "DataCite", "OpenAIRE", "Dataverse installations", "Google Dataset Search"],
    "rule": "For any named university, research institute, region or industry, resolve the institution first, enumerate its public repositories and flagship data projects, then prefer official institutional/subject repositories over community copies.",
    "ingestion": "Search and metadata discovery stay in intelligence center. Only task-relevant, licensed, validated, bounded data are frozen into immutable compute packs.",
    "restricted_data": "Restricted, credentialed, licensed, confidential or personal microdata are metadata-only until access rights are explicitly available; never bypass repository controls.",
    "dedupe": "Use DOI/DataCite ID, repository persistent ID, ROR affiliation, dataset checksum and source lineage to avoid duplicate copies."
  },
