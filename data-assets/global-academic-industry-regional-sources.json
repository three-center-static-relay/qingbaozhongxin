  "routing_policy": {
    "named_university_query": "Resolve ROR identity, inspect explicit anchor, then re3data/OpenDOAR/DataCite/OpenAIRE/Dataverse for institution-affiliated repositories and datasets.",
    "named_region_query": "Use national official statistics first, then local government/open data, then universities/research institutes located in or studying the region, then global cross-check sources.",
    "named_industry_query": "Use official regulator/statistics/industry datasets first, then university flagship research databases and reproducibility datasets, then community hubs.",
    "quality_rule": "University affiliation alone does not make a dataset ground truth; score methodology, provenance, sample design, revisions, representativeness, license and reproducibility."
  }
