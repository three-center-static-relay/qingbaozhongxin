  "schema_version": "2026-08-16.2",
  "purpose": "Persistent discovery plan for high-value public datasets, scientific data repositories, competitions, benchmarks and reusable notebook/project templates. Metadata index only; never mirror whole platforms.",
  "policy": {
    "china_priority": true,
    "metadata_only_recurring": true,
    "raw_dataset_mirror": false,
    "raw_notebook_copy": false,
    "auto_execute_notebook": false,
    "task_bound_download_only": true,
    "prefer_official_source_when_equivalent": true,
    "fixed_domain_portal_rotation": true,
    "required_before_task_freeze": ["license_or_terms_known","provenance_known","geography_time_fit","schema_units_known","sensitive_data_screen","deduplicate","hash_immutable_task_pack"],
    "blocked": ["credential dumps","doxxing","illicit personal-data collections","unknown-license bulk copying","unreviewed face or identity datasets","automatic execution of third-party notebook code"]
  },
  "cadence": {
    "cloudflare_cron": "daily",
    "active_api_collectors": "one rotating China/domain query per active source",
    "fixed_domain_portals": "one China portal plus one global portal per day",
    "large_catalogs": "discovery metadata only; no recurring bulk transfer",
    "task_retrieval": "on demand after governance approval"
  },
