{
  "schema_version": "2026-08-15.1",
  "purpose": "Persistent discovery plan for high-value public datasets and reusable notebook/method templates. Metadata index only; never mirror whole platforms.",
  "policy": {
    "china_priority": true,
    "metadata_only_recurring": true,
    "raw_dataset_mirror": false,
    "raw_notebook_copy": false,
    "task_bound_download_only": true,
    "prefer_official_source_when_equivalent": true,
    "required_before_task_freeze": ["license_or_terms_known", "provenance_known", "geography_time_fit", "schema_units_known", "sensitive_data_screen", "deduplicate", "hash_immutable_task_pack"],
    "blocked": ["credential dumps", "doxxing", "illicit personal-data collections", "unknown-license bulk copying"]
  },
  "cadence": {
    "cloudflare_cron": "daily",
    "daily_collectors": "one rotating China/domain query per active source",
    "large_catalogs": "discovery metadata only; no recurring bulk transfer",
    "task_retrieval": "on demand after governance approval"
  },
