  "schema_version": "2026-08-15.1",
  "purpose": "Global discovery registry for public/free datasets. This is a catalog, not a raw-data mirror. Intelligence-center discovery freezes approved task-ready data packs for the network-denied compute center.",
  "selection_policy": {
    "priority_order": ["authoritative_official","primary_research_repository","curated_open_data_cloud","community_dataset_hub","secondary_aggregator"],
    "required_checks": ["license_or_terms_known","provenance_known","geography_and_time_fit","schema_and_units_known","freshness_fit","quality_or_methodology_available","no_sensitive_or_illicit_personal_data","deduplicate_against_existing_sources"],
    "task_pack_rule": "Do not copy entire platforms into compute. Search dynamically, select bounded datasets, validate, hash, freeze and send immutable task packs.",
    "community_hub_rule": "Kaggle/Hugging Face/OpenML/UCI/community repositories are candidate pools, not ground truth. Prefer official-source versions when equivalent.",
    "embedded_dataset_rule": "Library-bundled toy/example datasets are for tests, smoke checks, algorithm validation and benchmarks only unless their provenance independently qualifies as real task evidence."
  },
