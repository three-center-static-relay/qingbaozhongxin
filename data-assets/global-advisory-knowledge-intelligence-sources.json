  "schema_version": "2026-08-15.1",
  "purpose": "Global advisory-grade source registry for policy, strategy, intelligence, think-tank research, institutional knowledge, literature, methods and sector information. Registry entries are discovery anchors; they do not imply unrestricted full-text redistribution or a live API unless machine_access says so.",
  "principles": {
    "priority_order": ["primary_official", "open_primary_archive", "peer_reviewed_or_methodologically_transparent", "independent_thinktank", "university_research_center", "secondary_analysis"],
    "free_first": true,
    "rights_rule": "Respect source-specific copyright, fair-use, non-commercial and account restrictions. Store citations/metadata and bounded task extracts rather than mirroring restricted corpora.",
    "china_realname_rule": "Mainland-China sources requiring real-name registration are discovery-only until explicit legal/privacy review; do not auto-register or automate credential creation.",
    "advisory_rule": "Opinion/think-tank outputs are analytical inputs, not ground truth. Cross-check policy claims against primary laws, official data and independent sources.",
    "dynamic_discovery": ["OpenAlex", "Crossref", "DataCite", "OpenAIRE", "CORE", "BASE", "re3data", "OpenDOAR", "ROR", "Google Dataset Search", "Google Scholar/web discovery where permitted"]
  },
