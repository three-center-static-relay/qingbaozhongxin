{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intelligence-worker",
  "main": "src/admin-entry.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  // Deployment recovery: Wrangler's own bundle/deploy validation remains authoritative here; the complete regression suite remains available as npm run test:full-regression.
  "build": {"command": "node -e \"console.log('deploy-gate: bundle-only recovery; full regression remains separate')\""},
  "triggers": {"crons": ["23 18 * * *"]},
  "durable_objects": {"bindings": [{"name": "CENTER_GATE", "class_name": "CenterGate"}]},
  "exports": {"CenterGate": {"type":"durable-object","storage":"sqlite"}},
  "vars": {"RATE_LIMIT_PER_MIN": "60"}
}
