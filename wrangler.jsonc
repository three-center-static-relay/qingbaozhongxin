{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intelligence-worker",
  "main": "src/admin-entry.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "build": {"command": "node tests/stress.mjs && node tests/catalog-version-gate-hygiene.mjs && node tests/qichacha.mjs && node tests/free-knowledge-sources.mjs && node tests/runtime-repairs.mjs && node tests/free-location-intelligence.mjs && node tests/global-high-value-data.mjs && node tests/nasa-high-value.mjs && node tests/global-academic-industry-regional.mjs && node tests/global-advisory-knowledge-intelligence.mjs && node tests/splus-institutional-expansion.mjs && node tests/splus-extension-2.mjs && node tests/elite-advisory-finance-intelligence.mjs && node tests/live-macro-fusion.mjs && node tests/china-intelligence-research-aifin.mjs && node tests/live-us-industry-health-spending.mjs && node tests/dataset-radar.mjs && node tests/dataset-radar-portals.mjs && node tests/google-pkulaw-hardening.mjs && node tests/yuandian-mcp.mjs && node tests/maps-mcp-tianditu.mjs && node tests/mcp-migration-gate.mjs && node tests/provider-fresh-e2e.mjs && node tests/google-routing-contract.mjs && node tests/live-global-events-trade-health.mjs && node tests/live-biomed-knowledge.mjs && node tests/live-corporate-markets-procurement.mjs && node tests/akshare-aktools.mjs && node tests/live-policy-regulatory-primary.mjs && node tests/intelligence-branch-architecture.mjs && node tests/knowledge-archives-branch.mjs && node tests/global-institution-discovery.mjs && node tests/web-search-providers.mjs && node tests/literature-keyed-providers.mjs && node tests/literature-production-selftest.mjs && node tests/admin-context-contract.mjs"},
  "triggers": {"crons": ["23 18 * * *"]},
  "durable_objects": {"bindings": [{"name": "CENTER_GATE", "class_name": "CenterGate"}]},
  "exports": {"CenterGate": {"type":"durable-object","storage":"sqlite"}},
  "vars": {"RATE_LIMIT_PER_MIN": "60"}
}
