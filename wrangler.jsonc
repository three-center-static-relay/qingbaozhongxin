{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intelligence-worker",
  "main": "src/guard.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "build": {"command": "node tests/global-high-value-data.mjs && node tests/nasa-high-value.mjs && node tests/global-academic-industry-regional.mjs && node tests/global-advisory-knowledge-intelligence.mjs && node tests/splus-institutional-expansion.mjs && node tests/splus-extension-2.mjs"},
  "triggers": {"crons": ["23 18 * * *"]},
  "durable_objects": {"bindings": [{"name": "CENTER_GATE", "class_name": "CenterGate"}]},
  "exports": {"CenterGate": {"type":"durable-object","storage":"sqlite"}},
  "vars": {"RATE_LIMIT_PER_MIN": "60"}
}
