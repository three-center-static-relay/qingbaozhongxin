{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intelligence-worker",
  "main": "src/admin-entry.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "secrets": {"required": ["ZENODO_TOKEN", "KAGGLE_API_TOKEN"]},
  "build": {"command": "node tests/medical-live-core.mjs && node tests/medical-live-core-wave2.mjs && node tests/medical-live-core-wave3.mjs && node tests/medical-live-core-wave4.mjs && node tests/medical-live-core-wave5.mjs && node tests/medical-top-tier-search.mjs"},
  "triggers": {"crons": ["23 18 * * *"]},
  "durable_objects": {"bindings": [{"name": "CENTER_GATE", "class_name": "CenterGate"}]},
  "exports": {"CenterGate": {"type":"durable-object","storage":"sqlite"}},
  "vars": {"RATE_LIMIT_PER_MIN": "60"}
}