{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intelligence-worker",
  "main": "src/browser-run-cn-e2e-entry.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "browser": {"binding": "BROWSER"},
  "build": {"command": "node tests/browser-run-cn-e2e-contract.mjs"},
  "vars": {"BROWSER_RUN_E2E_TARGET": "https://www.gov.cn/", "BROWSER_RUN_E2E_REV": "20260817-1"}
}
