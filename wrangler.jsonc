{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intelligence-worker",
  "main": "src/intelligence-fusion-entry.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "browser": {"binding": "BROWSER"},
  "ai": {"binding": "AI"},
  "secrets": {"required": ["ZENODO_TOKEN", "KAGGLE_API_TOKEN"]},
  "build": {"command": "npm run test:build-gate"},
  "triggers": {"crons": ["23 18 * * *"]},
  "durable_objects": {"bindings": [{"name": "CENTER_GATE", "class_name": "CenterGate"}]},
  "exports": {"CenterGate": {"type":"durable-object","storage":"sqlite"}},
  "vars": {
    "RATE_LIMIT_PER_MIN": "60",
    "MODEL_SOURCE_POLICY":"three-source-cloudflare-free-first",
    "MODEL_SOURCE_CLASSES":"workers-ai,openrouter,huggingface",
    "WORKERS_AI_FREE_ONLY":"true",
    "INTELLIGENCE_ANALYSIS_MODEL":"@cf/nvidia/nemotron-3-120b-a12b",
    "INTELLIGENCE_AI_ADVISORY_ENABLED":"false",
    "INTELLIGENCE_AI_ADVISORY_AUTOMATIC":"false",
    "INTELLIGENCE_AUTO_PAID_BUDGET_USD":"0"
  },
  "observability": {"enabled":true,"logs":{"enabled":true,"head_sampling_rate":1},"traces":{"enabled":true,"head_sampling_rate":0.02}}
}
